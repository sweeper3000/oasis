# Optional settings for compose.example.yaml. Copy to .env to customize.
OASIS_BIND_ADDRESS=127.0.0.1
OASIS_PORT=8000

# Optional global encryption secret: a 12+ character passphrase or a key
# generated once with `openssl rand -hex 32`.
# Back it up separately. Changing/losing it makes encrypted files unreadable.
# Also uncomment the environment/key entries in compose.example.yaml to use it.
# Leave commented to set individual provider keys in Oasis settings instead.
# OASIS_STORAGE_KEY=<paste your generated key here>
